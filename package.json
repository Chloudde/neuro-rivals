{
  "name": "neuro-rivals",
  "version": "0.1.0",
  "description": "A 2D top-down racer where neural-network AI drivers evolve to beat the player.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "train": "tsx scripts/train.ts",
    "sim": "tsx scripts/sim-race.ts",
    "check:tracks": "tsx scripts/check-tracks.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
